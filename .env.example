# OCTALVE BOOKING — configuration template; values intentionally blank.
# Add secrets only to the target Vercel project's Environment Variables.
# A configured variable DOES NOT enable an unfinished feature.
NODE_ENV=production
BOOKING_APP_ORIGIN=
DATABASE_URL=
AUTH_PASSWORD_PEPPER=
AUTH_MAIL_ENCRYPTION_KEY=
AUTH_RATE_KEY_SECRET=
EMAIL_FROM=
RESEND_API_KEY=
AUTH_OUTBOX_CRON_SECRET=
# Leave all switches off until every endpoint, database permission and provider test is complete.
BOOKING_AUTH_ENABLED=0
BOOKING_SUBMISSIONS_ENABLED=0
BOOKING_PAYMENTS_ENABLED=0
BOOKING_NOTIFICATIONS_ENABLED=0

# Optional Google OIDC: do not use until callback/PKCE/state/nonce logic is qualified.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional payment providers (server-only):
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
MONNIFY_API_KEY=
MONNIFY_CLIENT_SECRET=
MONNIFY_CONTRACT_CODE=

# Optional calendar/meeting providers (server-only):
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Never place DATABASE_MIGRATION_URL in the Vercel app's runtime variables.
# Only a separately authorised release/migration job should use it.
